<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  "development" doğru değer: Xcode dağıtım için arşivlerken bunu otomatik
	  olarak "production" yapıyor. Elle "production" yazmak, telefona doğrudan
	  atılan test derlemelerinde bildirimlerin sessizce gelmemesine yol açar.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
