# Ortam değişkenleri — YALNIZCA ADLAR.
#
# Bu dosyada hiçbir gerçek değer yok ve olmamalı. Gerçek değerler iki yerde:
#   * Vercel → Proje (akademi-v2) → Settings → Environment Variables
#   * Yerelde çalıştırılacaksa, bu dosyanın kopyası olan .env.local
#     (.gitignore'da; repoya girmez)
#
# Bir değişken eklendiğinde ya da değiştiğinde Vercel'de yeniden dağıtım
# (Redeploy) gerekir; çalışan sürüm eski değeri kullanmaya devam eder.

# --- Supabase ------------------------------------------------------------
# Herkese açık (tarayıcıya da gider): proje adresi ve anon anahtar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GİZLİ. Yalnız sunucu: zamanlanmış görevler (zamanlı blog yayını dahil) bununla çalışır.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
PANEL_URL=
# Arama motorlarına açık alan adları, virgülle (boşsa hiçbiri indekslenmez).
INDEKSLENEBILIR_ALAN_ADLARI=
# Ön yüz kapalıyken siteyi görebilen kullanıcı kimlikleri, virgülle.
ON_YUZ_ONIZLEME=

# --- Eski WordPress ------------------------------------------------------
# Blog görselleri taşınana kadar /wp-content/... istekleri buraya gider.
# Örnek: https://wp.ahmetekinciakademi.com
WORDPRESS_KAYNAK=

# --- Zamanlanmış görevler ------------------------------------------------
# GİZLİ. Veritabanındaki private.gorev_ayarlari → gorev_anahtari ile AYNI olmalı
# (docs/dayaniklilik.md → "Zamanlanmış görevlerin anahtarı").
GOREV_ANAHTARI=

# --- E-posta (Resend) ----------------------------------------------------
RESEND_API_KEY=
BILDIRIM_EPOSTA=
BILDIRIM_GONDEREN=

# --- Google: Analytics 4 ve Search Console -------------------------------
GA4_PROPERTY_ID=
GA4_MP_API_SECRET=
# Hizmet hesabı (GA4 ve Search Console ortak). Özel anahtar GİZLİ.
GA4_SA_CLIENT_EMAIL=
GA4_SA_PRIVATE_KEY=
# Örnek: sc-domain:ahmetekinciakademi.com
GSC_SITE_URL=

# --- Google: giriş ve takvim ---------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_TAKVIM_ID=
GOOGLE_TAKVIM_ISTEMCI_ID=
GOOGLE_TAKVIM_ISTEMCI_SIRRI=
GOOGLE_TAKVIM_YENILEME_ANAHTARI=

# --- Formlar (Tally) -----------------------------------------------------
TALLY_IMZA_ANAHTARI=

# --- Ödeme (iyzico) ------------------------------------------------------
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# "canli" ya da boş (boşsa test ortamı).
IYZICO_ORTAM=

# --- Video (Bunny) -------------------------------------------------------
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# --- iOS bildirimleri (APNs) ---------------------------------------------
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=
